# Application
APP_NAME=Movie Booking API
APP_VERSION=1.0.0
APP_DEBUG=true

# Database
# Chạy bằng docker compose thì backend tự dùng host `postgres`; ba biến dưới
# chỉ để compose tạo DB. Chạy tay ngoài docker mới cần DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movie_booking
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/movie_booking

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — thêm origin của tunnel nếu test VNPay qua cloudflared/ngrok
CORS_ORIGINS=["http://localhost:3000"]

# JWT - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seat Lock
SEAT_LOCK_TTL=900

# VNPay - bắt buộc, app không khởi động được nếu thiếu
VNPAY_TMN_CODE=your-vnpay-terminal-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result

# Frontend — nhúng vào bundle lúc BUILD, đổi thì phải build lại image
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
